# Neon / any PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Random string of at least 32 characters used to sign login sessions.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# First admin account created by `npm run setup` (only when there are no users yet)
SEED_ADMIN_EMAIL="code.7motors@gmail.com"
SEED_ADMIN_PASSWORD=""
# Optional
# DB_POOL_MAX=5
# DATABASE_SSL_NO_VERIFY=1   # only for a self-signed database server
