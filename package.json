{
  "name": "seven-motors",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node -r ./tests/preload.cjs --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node -r ./tests/preload.cjs --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node -r ./tests/preload.cjs --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:all": "node -r ./tests/preload.cjs --import tsx --test --test-concurrency=1 tests/*/*.test.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "drizzle-kit push && tsx scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "drizzle-orm": "0.36.4",
    "jose": "5.9.6",
    "lucide-react": "0.460.0",
    "next": "14.2.35",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.5",
    "drizzle-kit": "0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
